# ConvoAI Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# GEMINI API CONFIGURATION
# =============================================================================
# Get your free Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# =============================================================================
# FIREBASE CONFIGURATION - WEB
# =============================================================================
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_WEB_APP_ID=YOUR_FIREBASE_WEB_APP_ID
FIREBASE_WEB_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_WEB_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_WEB_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_WEB_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# =============================================================================
# FIREBASE CONFIGURATION - ANDROID
# =============================================================================
FIREBASE_ANDROID_API_KEY=YOUR_FIREBASE_ANDROID_API_KEY
FIREBASE_ANDROID_APP_ID=YOUR_FIREBASE_ANDROID_APP_ID
FIREBASE_ANDROID_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_ANDROID_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_ANDROID_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app

# =============================================================================
# FIREBASE CONFIGURATION - IOS
# =============================================================================
FIREBASE_IOS_API_KEY=YOUR_FIREBASE_IOS_API_KEY
FIREBASE_IOS_APP_ID=YOUR_FIREBASE_IOS_APP_ID
FIREBASE_IOS_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_IOS_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_IOS_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_IOS_BUNDLE_ID=com.example.myApp

# =============================================================================
# FIREBASE CONFIGURATION - MACOS
# =============================================================================
FIREBASE_MACOS_API_KEY=YOUR_FIREBASE_MACOS_API_KEY
FIREBASE_MACOS_APP_ID=YOUR_FIREBASE_MACOS_APP_ID
FIREBASE_MACOS_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_MACOS_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_MACOS_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_MACOS_BUNDLE_ID=com.example.myApp

# =============================================================================
# FIREBASE CONFIGURATION - WINDOWS
# =============================================================================
FIREBASE_WINDOWS_API_KEY=YOUR_FIREBASE_WINDOWS_API_KEY
FIREBASE_WINDOWS_APP_ID=YOUR_FIREBASE_WINDOWS_APP_ID
FIREBASE_WINDOWS_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_WINDOWS_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_WINDOWS_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_WINDOWS_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_WINDOWS_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
