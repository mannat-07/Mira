# ConvoAI Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# AGORA CONFIGURATION
# =============================================================================
# Get your Agora credentials from: https://console.agora.io/
AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_TOKEN=YOUR_AGORA_TOKEN
AGORA_CERTIFICATE=YOUR_AGORA_CERTIFICATE

# Agora AI API Base URL (if using Agora AI services)
AGORA_AI_BASE_URL=https://api.agora.io/v1/ai
